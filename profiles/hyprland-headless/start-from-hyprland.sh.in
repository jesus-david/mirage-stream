#!/usr/bin/env bash
set -euo pipefail

# This script is launched by Hyprland's exec-once. Importing these values here
# lets the user service connect to the same compositor instance as Hyprland.
if [[ "${XDG_CURRENT_DESKTOP:-}" != "Hyprland" ]] || [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    echo "mirage-stream: refusing to start outside Hyprland" >&2
    exit 1
fi

systemctl --user import-environment \
    WAYLAND_DISPLAY \
    HYPRLAND_INSTANCE_SIGNATURE \
    XDG_RUNTIME_DIR \
    DBUS_SESSION_BUS_ADDRESS \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_ID

systemctl --user start mirage-stream-hyprland.service
