#!/usr/bin/env bash
set -euo pipefail

readonly output_name="MIRAGE"
readonly workspace_id="21"
readonly config_file="@TARGET_HOME@/.config/sunshine/sunshine-hyprland.conf"
readonly stream_stop="@TARGET_HOME@/.local/lib/mirage-stream/stream-stop.sh"

created_output=false

log() {
    printf 'mirage-stream: %s\n' "$*" >&2
}

require_hyprland() {
    [[ "${XDG_CURRENT_DESKTOP:-}" == "Hyprland" ]] || {
        log "Hyprland is not the current desktop"
        exit 1
    }
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || {
        log "HYPRLAND_INSTANCE_SIGNATURE is missing"
        exit 1
    }
}

monitor_json() {
    hyprctl -j monitors all
}

output_exists() {
    monitor_json | jq -e --arg name "$output_name" '.[] | select(.name == $name)' >/dev/null
}

# hyprctl keyword/dispatch (classic syntax) do not work on Hyprland's
# non-legacy Lua config parser (dots-hyprland/end-4): they print
# "keyword can't work with non-legacy parsers. Use eval." to stderr but still
# exit 0, so a bare `set -e` script silently no-ops instead of failing loudly.
# hyprctl eval + the hl.* Lua API (see ~/.config/hypr/hl.meta.lua) is the
# supported replacement.
hleval() {
    local result
    result="$(hyprctl eval "$1")"
    [[ "$result" == "ok" ]] || log "hyprctl eval failed ('$result'): $1"
}

cleanup() {
    "$stream_stop" >/dev/null 2>&1 || true
    if $created_output && output_exists; then
        hyprctl output remove "$output_name" >/dev/null 2>&1 || true
    fi
}

trap cleanup EXIT INT TERM

require_hyprland

# Self-heal: if a previous session was killed or the machine was powered off
# mid-stream, stream-stop.sh never ran and the bar (and the physical
# monitors) can be left pointed at the virtual MIRAGE output. stream-stop.sh
# persists its restore state to disk and no-ops if there is nothing to
# restore, so it is safe to replay unconditionally before touching anything
# else.
"$stream_stop" >/dev/null 2>&1 || true

if ! output_exists; then
    hyprctl output create headless "$output_name"
    created_output=true
    # A freshly created headless output needs a moment before Hyprland will
    # accept an hl.monitor rule targeting it by name; without this, the very
    # next hleval call below silently keeps the default 1920x1080 mode.
    for _ in 1 2 3 4 5; do
        output_exists && break
        sleep 0.5
    done
fi

# Position far from the real monitor layout, not "auto" (which places it
# snugly adjacent to DP-5/DP-6): while idle -- service running, no client
# connected yet, physical monitors still enabled -- "auto" placement let the
# mouse cursor wander onto MIRAGE by accident, since there's nothing
# physically displayed there. A monitor rectangle with a gap to every other
# monitor is unreachable by normal cursor movement, but Sunshine's wlr
# capture still works fine against it regardless of its coordinates.
hleval "hl.monitor({ output = \"$output_name\", mode = \"2560x1440@60\", position = \"10000x0\", scale = 1 })"
hleval "hl.workspace_rule({ workspace = \"$workspace_id\", monitor = \"$output_name\", default = true })"

mkdir -p "$(dirname "$config_file")"
cat >"$config_file" <<EOF
# Managed by mirage-stream --profile hyprland-headless.
global_prep_cmd = [{"do":"@TARGET_HOME@/.local/lib/mirage-stream/stream-start.sh","undo":"@TARGET_HOME@/.local/lib/mirage-stream/stream-stop.sh"}]
adapter_name = @RENDER_NODE@
output_name = $output_name
capture = wlr
encoder = nvenc
native_pen_touch = enabled
EOF

# Give Sunshine its Wayland display before locking the session. hypridle
# normally turns the loginctl lock request into hyprlock, but that chain can
# be broken depending on the active Hyprland config -- e.g. dots-hyprland's
# default hypridle.conf lock_cmd checks `pidof qs quickshell hyprlock` before
# falling back to hyprlock, and quickshell is always running as the desktop
# shell, so the fallback never fires if quickshell's own lock screen doesn't
# come up. Don't rely on that chain alone: still ask logind properly (other
# tools may care about LockedHint), but also make sure hyprlock itself ends
# up running a moment later regardless of whether anything reacted to it.
/usr/bin/sunshine "$config_file" &
sunshine_pid=$!
sleep 2
if kill -0 "$sunshine_pid" 2>/dev/null; then
    if [[ -n "${XDG_SESSION_ID:-}" ]]; then
        loginctl lock-session "$XDG_SESSION_ID"
    else
        loginctl lock-session
    fi
    sleep 1
    pidof hyprlock >/dev/null 2>&1 || hyprlock &
fi

wait "$sunshine_pid"
