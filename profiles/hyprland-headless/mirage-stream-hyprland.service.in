[Unit]
Description=Mirage Stream headless Sunshine session for Hyprland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@TARGET_HOME@/.local/lib/mirage-stream/hyprland-headless-session.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
