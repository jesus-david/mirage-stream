#!/usr/bin/env bash
set -euo pipefail

readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mirage-stream"
readonly state_file="$state_dir/physical-monitors.json"
readonly bar_config="$HOME/.config/illogical-impulse/config.json"
readonly bar_state_file="$state_dir/bar-output"

# hyprctl keyword/dispatch (classic syntax) do not work on Hyprland's
# non-legacy Lua config parser (dots-hyprland/end-4): they print
# "keyword can't work with non-legacy parsers. Use eval." to stderr but still
# exit 0, so a bare `set -e` script silently no-ops instead of failing loudly.
# hyprctl eval + the hl.* Lua API (see ~/.config/hypr/hl.meta.lua) is the
# supported replacement.
log() {
    printf 'mirage-stream: %s\n' "$*" >&2
}

hleval() {
    local result
    result="$(hyprctl eval "$1")"
    [[ "$result" == "ok" ]] || log "hyprctl eval failed ('$result'): $1"
}

restore_physical_monitors() {
    [[ -f "$state_file" ]] || return 0
    jq -r '.[] | "\(.name)\t\(.width)\t\(.height)\t\(.refreshRate)\t\(.x)\t\(.y)\t\(.scale)"' "$state_file" |
        while IFS=$'\t' read -r name width height refresh x y scale; do
            hleval "hl.monitor({ output = \"$name\", mode = \"${width}x${height}@${refresh}\", position = \"${x}x${y}\", scale = $scale, disabled = false })"
        done
}

restore_local_workspace_rules() {
    hyprctl reload config-only

    for workspace in {1..20}; do
        case "$workspace" in
            9|10) local_monitor="DP-6" ;;
            *) local_monitor="DP-5" ;;
        esac
        hleval "hl.workspace_rule({ workspace = \"$workspace\", monitor = \"$local_monitor\" })"
    done
}

restore_local_workspace_locations() {
    mapfile -t workspaces < <(
        hyprctl -j workspaces | jq -r ".[] | select(.id >= 1 and .id <= 20) | .id"
    )

    for workspace in "${workspaces[@]}"; do
        case "$workspace" in
            9|10) local_monitor="DP-6" ;;
            *) local_monitor="DP-5" ;;
        esac
        hleval "hl.dispatch(hl.dsp.workspace.move({ workspace = \"$workspace\", monitor = \"$local_monitor\" }))"
    done
}

# If none of a monitor's assigned workspaces (e.g. 9/10 for DP-6) was
# visited during the stream, restore_local_workspace_locations has nothing
# to move there, so that monitor stays on whatever it had during the
# stream and Hyprland fills it with a fresh out-of-range workspace (e.g.
# 23) -- desyncing the bar's workspace numbering (bug seen 2026-08-03,
# 2026-08-11, 2026-08-29). Force-focus each monitor's default workspace,
# then restore whatever was actually focused.
restore_default_workspace_focus() {
    local previous_workspace
    previous_workspace="$(hyprctl -j activeworkspace | jq -r '.id')"

    hleval 'hl.dispatch(hl.dsp.focus({ workspace = "1" }))'
    hleval 'hl.dispatch(hl.dsp.focus({ workspace = "9" }))'
    hleval "hl.dispatch(hl.dsp.focus({ workspace = \"$previous_workspace\" }))"
}

# Mirror of save_and_switch_bar_output in stream-start.sh: quickshell reads
# bar.screenList from this file with hot-reload, no service restart needed.
restore_bar_output() {
    [[ -s "$bar_state_file" && -f "$bar_config" ]] || return 0

    python3 - "$bar_config" "$bar_state_file" <<'PYEOF'
import json, sys

config_path, state_path = sys.argv[1], sys.argv[2]

with open(state_path) as f:
    screen_list = json.load(f)

with open(config_path) as f:
    config = json.load(f)

config.setdefault("bar", {})["screenList"] = screen_list
with open(config_path, "w") as f:
    json.dump(config, f, indent=2, ensure_ascii=False)
    f.write("\n")
PYEOF
}

[[ -f "$state_file" ]] || exit 0
[[ "${XDG_CURRENT_DESKTOP:-}" == "Hyprland" ]] || exit 1
[[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || exit 1

restore_physical_monitors

restore_local_workspace_rules

restore_local_workspace_locations

restore_default_workspace_focus

if hyprctl -j workspaces | jq -e '.[] | select(.id == 21)' >/dev/null; then
    hleval 'hl.dispatch(hl.dsp.workspace.move({ workspace = "21", monitor = "MIRAGE" }))'
fi

restore_bar_output

if [[ -x "$HOME/.config/hypr/scripts/WallpaperDaemon.sh" ]]; then
    "$HOME/.config/hypr/scripts/WallpaperDaemon.sh" &
fi

rm -f "$state_file" "$bar_state_file"
